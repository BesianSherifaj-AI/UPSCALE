 import cv2
 import numpy as np
+
+
+def _half_motion(motion: np.ndarray) -> np.ndarray:
+    # SIMD conversion preserves finite IEEE half values and avoids NumPy's
+    # slower scalar float16 conversion. Keep NumPy for exceptional fields so
+    # signaling-NaN payloads retain their original conversion behavior too.
+    if np.isfinite(motion).all():
+        return cv2.convertFp16(motion).view(np.float16)
+    return np.ascontiguousarray(motion.astype(np.float16))
+
 
