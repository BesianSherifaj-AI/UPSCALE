+++ b/dlss_engine/frame_interpolation/pipeline.py
@@ -0,0 +1,244 @@
+"""Ordered, bounded streaming between independent DLSSG temporal histories.
+
+Each stage belongs to exactly one thread for the entire video. Frames are never
+split into independently initialized chunks. A stage can prepare its next motion
+field while a later stage is waiting for its native worker's GPU result.
+"""
+from __future__ import annotations
+
+from contextlib import suppress
+from dataclasses import asdict, dataclass, field
+from queue import Empty, Full, Queue
+import threading
+import time
+from typing import Callable, Iterable, Protocol, TypeVar
+
+from ..core.jobs import Cancelled
+
+
+T = TypeVar("T")
+_END = object()
+_POLL_SECONDS = 0.05
+
+
+class Stage(Protocol[T]):
+    def push(self, frame: T) -> Iterable[T]: ...
+
+
+@dataclass
+class PipelineStats:
+    mode: str
+    queue_capacity: int
+    stage_seconds: list[float] = field(default_factory=list)
+    stage_inputs: list[int] = field(default_factory=list)
+    stage_outputs: list[int] = field(default_factory=list)
+    maximum_queue_frames: list[int] = field(default_factory=list)
+    source_seconds: float = 0.0
+    sink_seconds: float = 0.0
+    elapsed_seconds: float = 0.0
+
+    def as_dict(self) -> dict:
+        return asdict(self)
+
+
+def queue_capacity(width: int, height: int, stage_count: int) -> int:
+    """Limit queued RGBA storage to ~96 MiB, or one frame per link minimum.
+
+Stage histories, current work and native allocations are additional. Limiting
+each link to four frames also prevents excessive decode-ahead on small videos.
+"""
+    if width <= 0 or height <= 0 or stage_count < 0:
+        raise ValueError("Pipeline dimensions must be positive and stage count nonnegative.")
+    frame_bytes = width * height * 4
+    return max(1, min(4, (96 * 1024 * 1024) // ((stage_count + 1) * frame_bytes)))
+
+
+class _Stopped(Exception):
+    pass
+
+
+def process_frames(
+    source: Iterable[T],
+    stages: list[Stage[T]],
+    consume: Callable[[T], None],
+    *,
+    cancel: threading.Event,
+    abort: Callable[[], None],
+    capacity: int,
+    parallel: bool,
+    join_timeout: float = 5.0,
+) -> PipelineStats:
+    """Consume every transformed frame in order, propagating the first failure.
+
+``abort`` must promptly terminate the native workers and encoder without waiting
+on their Python pipe locks. This releases blocked native reads/writes on error.
+Cancellation is polled even with full/empty queues. Shutdown joins have a shared
+deadline and threads are daemonized as a final guard against a broken extension.
+"""
+    if capacity < 1:
+        raise ValueError("Pipeline queue capacity must be at least one frame.")
+    count = len(stages)
+    stats = PipelineStats(
+        "parallel" if parallel and count else "serial", capacity if parallel and count else 0,
+        [0.0] * count, [0] * count, [0] * count,
+        [0] * (count + 1) if parallel and count else [],
+    )
+    started = time.perf_counter()
+
+    def check_cancel() -> None:
+        if cancel.is_set():
+            raise Cancelled("Frame interpolation stopped by user.")
+
+    def measured_source():
+        iterator = iter(source)
+        try:
+            while True:
+                check_cancel()
+                before = time.perf_counter()
+                try:
+                    item = next(iterator)
+                except StopIteration:
+                    return
+                finally:
+                    stats.source_seconds += time.perf_counter() - before
+                yield item
+        finally:
+            if hasattr(iterator, "close"):
+                iterator.close()
+
+    if stats.mode == "serial":
+        try:
+            for item in measured_source():
+                items = [item]
+                for index, stage in enumerate(stages):
+                    outputs = []
+                    for current in items:
+                        check_cancel()
+                        before = time.perf_counter()
+                        transformed = list(stage.push(current))
+                        stats.stage_seconds[index] += time.perf_counter() - before
+                        stats.stage_inputs[index] += 1
+                        stats.stage_outputs[index] += len(transformed)
+                        outputs.extend(transformed)
+                    items = outputs
+                for current in items:
+                    check_cancel()
+                    before = time.perf_counter()
+                    consume(current)
+                    stats.sink_seconds += time.perf_counter() - before
+            return stats
+        except BaseException:
+            with suppress(Exception):
+                abort()
+            raise
+        finally:
+            stats.elapsed_seconds = time.perf_counter() - started
+
+    queues = [Queue(maxsize=capacity) for _ in range(count + 1)]
+    stopped = threading.Event()
+    failure_lock = threading.Lock()
+    failures: list[BaseException] = []
+
+    def fail(exc: BaseException) -> None:
+        with failure_lock:
+            first = not failures
+            if first:
+                failures.append(exc)
+            stopped.set()
+        if first:
+            with suppress(Exception):
+                abort()
+
+    def check_running() -> None:
+        check_cancel()
+        if stopped.is_set():
+            raise _Stopped()
+
+    def put(index: int, value) -> None:
+        while True:
+            check_running()
+            try:
+                queues[index].put(value, timeout=_POLL_SECONDS)
+                stats.maximum_queue_frames[index] = max(
+                    stats.maximum_queue_frames[index], queues[index].qsize()
+                )
+                return
+            except Full:
+                pass
+
+    def get(index: int):
+        while True:
+            check_running()
+            try:
+                return queues[index].get(timeout=_POLL_SECONDS)
+            except Empty:
+                pass
+
+    def feed() -> None:
+        try:
+            for item in measured_source():
+                put(0, item)
+            put(0, _END)
+        except _Stopped:
+            pass
+        except BaseException as exc:
+            fail(exc)
+
+    def transform(index: int) -> None:
+        try:
+            while True:
+                current = get(index)
+                if current is _END:
+                    put(index + 1, _END)
+                    return
+                before = time.perf_counter()
+                outputs = stages[index].push(current)
+                # Materialize only this one input's bounded native result. Queue
+                # waiting is excluded from the measured stage processing time.
+                outputs = list(outputs)
+                stats.stage_seconds[index] += time.perf_counter() - before
+                stats.stage_inputs[index] += 1
+                stats.stage_outputs[index] += len(outputs)
+                for output in outputs:
+                    put(index + 1, output)
+                del current, outputs
+        except _Stopped:
+            pass
+        except BaseException as exc:
+            fail(exc)
+
+    prefix = f"dlss-pipeline-{id(stats):x}"
+    threads = [threading.Thread(target=feed, name=f"{prefix}-decode", daemon=True)]
+    threads.extend(
+        threading.Thread(target=transform, args=(index,), name=f"{prefix}-stage-{index}", daemon=True)
+        for index in range(count)
+    )
+    try:
+        for thread in reversed(threads):
+            thread.start()
+        while True:
+            current = get(count)
+            if current is _END:
+                break
+            before = time.perf_counter()
+            consume(current)
+            stats.sink_seconds += time.perf_counter() - before
+            del current
+    except _Stopped:
+        pass
+    except BaseException as exc:
+        fail(exc)
+    finally:
+        stopped.set()
+        deadline = time.monotonic() + join_timeout
+        for thread in threads:
+            if thread.ident is not None:
+                thread.join(timeout=max(0.0, deadline - time.monotonic()))
+        living = [thread.name for thread in threads if thread.is_alive()]
+        if living:
+            fail(RuntimeError("Interpolation pipeline shutdown timed out: " + ", ".join(living)))
+        stats.elapsed_seconds = time.perf_counter() - started
+    if failures:
+        raise failures[0]
+    check_cancel()
+    return stats
